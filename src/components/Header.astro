---
import type { Lang, PageKey, Translations } from '../i18n/translations';

interface Props {
	active?: PageKey;
	lang: Lang;
	translations: Translations;
	navigationPaths: Record<PageKey, string>;
	languageLinks: { es: string; en: string };
}

const {
	active = 'home',
	lang,
	translations,
	navigationPaths,
	languageLinks,
} = Astro.props;

const isEnglish = lang === 'en';
---

<header class="header">
	<nav class="nav-container">
		<div class="logo">
			<a href={navigationPaths.home} class="logo-link">
				<img src="/liderazgo_afectivo_logo.svg" alt={translations.common.siteName} class="logo-image">
				<span>{translations.common.siteName}</span>
			</a>
		</div>
		<button class="hamburger" id="menuToggle" aria-label={translations.common.hamburgerLabel} aria-expanded="false" aria-controls="mainNav">
			<span></span>
			<span></span>
			<span></span>
		</button>
		<div class="nav-links" id="mainNav">
			<a href={navigationPaths.home} class={`nav-link ${active === 'home' ? 'active' : ''}`}>{translations.nav.home}</a>
			<a href={navigationPaths.preview} class={`nav-link ${active === 'preview' ? 'active' : ''}`}>{translations.nav.preview}</a>
			<a href={navigationPaths.blog} class={`nav-link ${active === 'blog' ? 'active' : ''}`}>{translations.nav.blog}</a>
			<a href={navigationPaths.contact} class={`nav-link ${active === 'contact' ? 'active' : ''}`}>{translations.nav.contact}</a>
			<a href={translations.common.externalLinkUrl} class="nav-link external" target="_blank" rel="noopener">{translations.common.externalLinkLabel}</a>
			<label class="language-toggle" aria-label={translations.common.languageToggleLabel}>
				<span class={`toggle-label ${!isEnglish ? 'active' : ''}`}>ES</span>
				<input
					type="checkbox"
					role="switch"
					aria-checked={isEnglish}
					data-lang-toggle
					data-es-href={languageLinks.es}
					data-en-href={languageLinks.en}
					checked={isEnglish}
				/>
				<span class={`toggle-label ${isEnglish ? 'active' : ''}`}>EN</span>
				<span class="toggle-slider" aria-hidden="true"></span>
			</label>
		</div>
	</nav>
</header>

<script>
/**
 * Controla el menú hamburguesa en móvil.
 * @returns {void}
 */
document.addEventListener('DOMContentLoaded', function() {
	const menuToggle = document.getElementById('menuToggle');
	const mainNav = document.getElementById('mainNav');
	const langToggle = document.querySelector('[data-lang-toggle]');

	if (menuToggle && mainNav) {
		menuToggle.addEventListener('click', function() {
			const expanded = menuToggle.getAttribute('aria-expanded') === 'true';
			menuToggle.setAttribute('aria-expanded', (!expanded) + "");
			mainNav.classList.toggle('open');
		});
	}

	if (langToggle instanceof HTMLInputElement) {
		const currentLang = document.documentElement.lang === 'en' ? 'en' : 'es';
		langToggle.checked = currentLang === 'en';
		langToggle.setAttribute('aria-checked', currentLang === 'en' ? 'true' : 'false');

		langToggle.addEventListener('change', function() {
			const targetLang = this.checked ? 'en' : 'es';
			try {
				window.localStorage.setItem('preferredLang', targetLang);
			} catch {
				// Ignore storage errors (private mode, etc.)
			}
			const href = this.dataset[targetLang + 'Href'];
			if (href) {
				window.location.href = href;
			}
		});
	}
});
</script>

<style>
	/* ===== Glass navigation — Technical Quiet Luxury ===== */
	.header {
		background: rgba(19, 19, 19, 0.6);
		backdrop-filter: blur(20px) saturate(140%);
		-webkit-backdrop-filter: blur(20px) saturate(140%);
		padding: 1.1rem 0;
		position: sticky;
		top: 0;
		z-index: 100;
		border-bottom: 1px solid var(--outline-soft);
	}

	.nav-container {
		max-width: var(--max-width);
		margin: 0 auto;
		padding: 0 2rem;
		display: grid;
		grid-template-columns: auto 1fr;
		gap: 1.5rem;
		align-items: center;
		position: relative;
	}

	.logo {
		display: flex;
		align-items: center;
	}

	.logo-link {
		display: flex;
		align-items: center;
		gap: 0.85rem;
		text-decoration: none;
	}

	.logo-image {
		height: 38px;
		width: auto;
		/* Tint logo SVG to primary mint — matches the single-accent rule */
		filter: brightness(0) saturate(100%) invert(72%) sepia(67%) saturate(2478%)
			hue-rotate(118deg) brightness(98%) contrast(101%);
		transition: filter 0.25s ease-out;
	}

	.logo-link span {
		font-family: var(--font-display);
		color: var(--on-surface-strong);
		font-size: 1.25rem;
		font-weight: 700;
		letter-spacing: -0.02em;
		transition: color 0.25s ease-out;
	}

	.logo-link:hover span {
		color: var(--primary);
	}

	.nav-links {
		display: flex;
		gap: 2rem;
		align-items: center;
		justify-content: flex-end;
		transition: max-height 0.3s ease, opacity 0.3s ease;
	}

	.nav-link {
		font-family: var(--font-body);
		font-size: 0.92rem;
		font-weight: 500;
		color: var(--on-surface-variant);
		text-decoration: none;
		transition: color 0.25s ease-out;
		position: relative;
		padding: 0.4rem 0;
	}

	.nav-link:hover {
		color: var(--on-surface-strong);
	}

	.nav-link.active {
		color: var(--on-surface-strong);
	}

	.nav-link.active::after {
		content: '';
		position: absolute;
		bottom: -6px;
		left: 0;
		right: 0;
		height: 2px;
		background: var(--primary-gradient);
		border-radius: 999px;
	}

	.nav-link.external {
		background: var(--primary-gradient);
		color: var(--on-primary);
		padding: 0.55rem 1.15rem;
		border-radius: var(--radius-md);
		font-weight: 600;
		letter-spacing: -0.005em;
		box-shadow: 0 1px 0 rgba(255, 255, 255, 0.25) inset,
			0 12px 28px -12px rgba(0, 224, 179, 0.55);
		transition: transform 0.2s ease-out, box-shadow 0.2s ease-out;
	}

	.nav-link.external:hover {
		color: var(--on-primary);
		transform: translateY(-1px);
		box-shadow: 0 1px 0 rgba(255, 255, 255, 0.3) inset,
			0 18px 36px -14px rgba(0, 224, 179, 0.65);
	}

	.nav-link.external::after {
		display: none;
	}

	.hamburger {
		display: none;
		flex-direction: column;
		justify-content: center;
		align-items: center;
		width: 40px;
		height: 40px;
		background: none;
		border: none;
		cursor: pointer;
		gap: 5px;
		z-index: 200;
	}

	.hamburger span {
		display: block;
		width: 26px;
		height: 2px;
		background: var(--on-surface);
		border-radius: 2px;
		transition: all 0.3s;
	}

	/* ===== Language toggle — mint accent ===== */
	.language-toggle {
		position: relative;
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.3rem 0.85rem;
		border-radius: 999px;
		background: var(--surface-container);
		cursor: pointer;
		user-select: none;
		overflow: hidden;
		box-shadow: inset 0 0 0 1px var(--outline-soft);
	}

	.language-toggle input {
		position: absolute;
		opacity: 0;
		width: 100%;
		height: 100%;
		cursor: pointer;
	}

	.toggle-label {
		font-family: var(--font-body);
		font-size: 0.78rem;
		letter-spacing: 0.04em;
		color: var(--on-surface-muted);
		font-weight: 600;
		transition: color 0.25s ease-out;
		position: relative;
		z-index: 1;
	}

	.toggle-label.active {
		color: var(--on-primary);
	}

	.toggle-slider {
		position: absolute;
		top: 0.25rem;
		bottom: 0.25rem;
		left: 0.3rem;
		width: calc(50% - 0.3rem);
		background: var(--primary-gradient);
		border-radius: 999px;
		transform: translateX(0);
		transition: transform 0.25s ease-out;
		z-index: 0;
		box-shadow: 0 4px 12px -4px rgba(0, 224, 179, 0.55);
	}

	.language-toggle input:checked ~ .toggle-slider {
		transform: translateX(100%);
	}

	@media (max-width: 900px) {
		.nav-container {
			padding: 1rem;
			grid-template-columns: auto auto;
			grid-template-rows: auto auto;
		}
		.hamburger {
			display: flex;
			grid-row: 1;
			grid-column: 2;
			justify-self: end;
		}
		.nav-links {
			position: absolute;
			top: 100%;
			right: 0;
			background: rgba(19, 19, 19, 0.92);
			backdrop-filter: blur(20px) saturate(140%);
			-webkit-backdrop-filter: blur(20px) saturate(140%);
			flex-direction: column;
			align-items: flex-end;
			gap: 0;
			width: 240px;
			max-height: 0;
			overflow: hidden;
			opacity: 0;
			border-radius: 0 0 0 var(--radius-lg);
			box-shadow: var(--shadow-ambient);
			border: 1px solid var(--outline-soft);
			border-top: none;
			transition: max-height 0.3s, opacity 0.3s;
			z-index: 150;
		}
		.nav-links.open {
			max-height: 520px;
			opacity: 1;
			padding: 1rem 0;
		}
		.nav-link {
			width: 100%;
			text-align: right;
			padding: 0.85rem 1.5rem;
			font-size: 1rem;
		}
		.nav-link.active::after {
			display: none;
		}
		.nav-link.external {
			margin: 0.5rem 1.5rem 0;
			text-align: center;
		}
		.language-toggle {
			margin: 0.75rem 1.5rem 0;
			align-self: center;
		}
		.logo-image {
			height: 30px;
		}
		.logo-link span {
			font-size: 1.1rem;
		}
	}
</style> 
