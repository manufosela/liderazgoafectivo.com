---
import { getTranslations } from '../i18n/translations';
import '../styles/pages/admin.css';

// Private page and its own site: no layout, menu, styles or analytics of the public web.
// Outside PATHS, so it is never in the menu nor in the sitemap.
const copy = getTranslations('es').admin;
if (!copy) throw new Error('es.json has no admin section');
// The panel script reads its messages from data-* attributes (dataset turns them back into camelCase).
const panelCopy = Object.fromEntries(Object.entries(copy.panel).map(([key, text]) => [`data-${key.replaceAll(/[A-Z]/g, (letter) => `-${letter.toLowerCase()}`)}`, text]));
---

<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex, nofollow" />
		<title>{copy.title}</title>
	</head>
	<body class="admin">
	<div id="admin" class="admin__app" {...panelCopy}>
		<p class="admin__status" role="status" data-status></p>

		<section class="admin__login" data-login>
			<button type="button" class="admin__button" data-sign-in>{copy.signIn}</button>
		</section>

		<div class="admin__panel" data-panel hidden>
			<header class="admin__bar">
				<span class="admin__brand">{copy.title}</span>
				<nav class="admin__sections" aria-label={copy.sectionsLabel}>
					<a href="/admin/" aria-current="page">{copy.sections.audiobook}</a>
				</nav>
				<button type="button" class="admin__ghost" data-sign-out>{copy.signOut}</button>
			</header>

			<main class="admin__main">
			<h1>{copy.heading}</h1>
			<div class="admin__tabs" role="tablist" aria-label={copy.heading} data-tabs>
				<button type="button" role="tab" id="admin-tab-codes" aria-controls="admin-codes" aria-selected="true">{copy.listHeading}</button>
				<button type="button" role="tab" id="admin-tab-create" aria-controls="admin-create" aria-selected="false" tabindex="-1">{copy.createHeading}</button>
			</div>

			<section class="admin__tab-panel" role="tabpanel" id="admin-create" aria-labelledby="admin-tab-create" hidden>
			<form class="admin__form" data-create>
				<label for="admin-email">{copy.fields.email}</label>
				<input id="admin-email" name="email" type="email" autocomplete="off" required />
				<label for="admin-note">{copy.fields.note}</label>
				<input id="admin-note" name="note" type="text" maxlength="80" required aria-describedby="admin-note-hint" />
				<p id="admin-note-hint" class="admin__hint">{copy.noteHint}</p>
				<button type="submit" class="admin__button">{copy.create}</button>
			</form>

			<div class="admin__result" data-result hidden>
				<label for="admin-message">{copy.resultLabel}</label>
				<textarea id="admin-message" rows="4" readonly data-message></textarea>
				<button type="button" class="admin__button" data-copy>{copy.copy}</button>
			</div>
			</section>

			<section class="admin__tab-panel" role="tabpanel" id="admin-codes" aria-labelledby="admin-tab-codes">
			<div class="admin__table-wrap">
				<table class="admin__table">
					<thead>
						<tr>
							<th scope="col">{copy.columns.id}</th>
							<th scope="col">{copy.columns.email}</th>
							<th scope="col">{copy.columns.note}</th>
							<th scope="col">{copy.columns.date}</th>
							<th scope="col">{copy.columns.status}</th>
							<th scope="col"><span class="admin__sr">{copy.columns.actions}</span></th>
						</tr>
					</thead>
					<tbody data-grants></tbody>
				</table>
			</div>
			</section>
			</main>
		</div>

		<dialog class="admin__dialog" aria-labelledby="admin-confirm-text" data-confirm>
			<p id="admin-confirm-text" data-confirm-text></p>
			<div class="admin__dialog-actions">
				<button type="button" class="admin__ghost" data-answer="cancel">{copy.cancel}</button>
				<button type="button" class="admin__button" data-answer="confirm">{copy.panel.revoke}</button>
			</div>
		</dialog>
	</div>
	</body>
</html>

<script>
	import { createAdminApi } from '../scripts/admin/api.js';
	import { createGoogleAuth, readFirebaseConfig } from '../scripts/admin/firebase.js';
	import { startPanel } from '../scripts/admin/panel.js';
	import { startTabs } from '../scripts/admin/tabs.js';

	const root = document.querySelector('#admin');
	startTabs(root.querySelector('[data-tabs]'));
	let config;
	try {
		config = readFirebaseConfig(import.meta.env);
	} catch (error) {
		root.querySelector('[data-status]').textContent = root.dataset.configMissing;
		root.querySelector('[data-sign-in]').disabled = true;
		throw error;
	}
	const auth = createGoogleAuth(config);
	startPanel({ root, auth, api: createAdminApi({ getToken: auth.getToken }), copy: root.dataset, clipboard: navigator.clipboard });
</script>
