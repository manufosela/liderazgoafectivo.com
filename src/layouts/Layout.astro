---
import type { Lang, Translations } from '../i18n/translations';

interface Props {
	title: string;
	description?: string;
	canonicalUrl?: string;
	lang: Lang;
	translations: Translations;
	alternateUrls?: Partial<Record<Lang | 'x-default', string>>;
	/** Private pages: keep them out of search engines. */
	noindex?: boolean;
	/** Private pages load no third-party script. */
	analytics?: boolean;
}

const {
	title,
	description = 'Liderazgo Afectivo - Un libro sobre liderazgo emocional y gestión de equipos',
	canonicalUrl = 'https://liderazgoafectivo.com',
	lang,
	translations,
	alternateUrls = {},
	noindex = false,
	analytics = true,
} = Astro.props;

const siteName = translations.common.siteName;
const bookDescription = translations.common.bookDescription;
const bookEdition = translations.common.bookEdition;
const ogLocale = translations.common.ogLocale;
const bookCoverImage = translations.common.bookCoverImage;

const siteBaseUrl = 'https://liderazgoafectivo.com';
const coverImageAbsolute = bookCoverImage.startsWith('http') ? bookCoverImage : `${siteBaseUrl}${bookCoverImage}`;

const bookSchema = {
	'@context': 'https://schema.org',
	'@type': 'Book',
	name: siteName,
	author: {
		'@type': 'Person',
		name: 'Manuel Fosela',
		url: 'https://manufosela.es',
		sameAs: ['https://twitter.com/manufosela', 'https://linkedin.com/in/manufosela'],
	},
	publisher: {
		'@type': 'Organization',
		name: 'Savvily Editorial',
		url: 'https://savvily.es',
	},
	datePublished: '2025-04-03',
	description: bookDescription,
	image: coverImageAbsolute,
	offers: {
		'@type': 'Offer',
		url: 'https://savvily.es/libros/liderazgo-afectivo/',
		priceCurrency: 'EUR',
		availability: 'https://schema.org/InStock',
	},
	workExample: {
		'@type': 'Book',
		bookEdition,
		bookFormat: 'https://schema.org/Paperback',
		numberOfPages: '250',
	},
};

const websiteSchema = {
	'@context': 'https://schema.org',
	'@type': 'WebSite',
	name: siteName,
	url: 'https://liderazgoafectivo.com',
};
---

<!DOCTYPE html>
<html lang={lang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		{lang === 'es' && alternateUrls.en && (
			<script is:inline define:vars={{ enUrl: alternateUrls.en }}>
				(function() {
					try {
						var stored = localStorage.getItem('preferredLang');
						if (stored) return;
						var browserLang = (navigator.languages && navigator.languages[0]) || navigator.language || '';
						if (!browserLang.toLowerCase().startsWith('es')) {
							localStorage.setItem('preferredLang', 'en');
							location.replace(enUrl);
						}
					} catch(e) {}
				})();
			</script>
		)}
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		{noindex && <meta name="robots" content="noindex, nofollow" />}
		<link rel="canonical" href={canonicalUrl} />

		<!-- Alternate language URLs -->
		{Object.entries({ ...alternateUrls }).map(([hrefLang, url]) => (
			<link rel="alternate" hreflang={hrefLang} href={url} />
		))}

		<!-- Open Graph / Facebook -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
	<meta property="og:image" content={coverImageAbsolute} />
		<meta property="og:site_name" content={siteName} />
		<meta property="og:locale" content={ogLocale} />

		<!-- Twitter -->
		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:url" content={canonicalUrl} />
		<meta property="twitter:title" content={title} />
		<meta property="twitter:description" content={description} />
	<meta property="twitter:image" content={coverImageAbsolute} />
		<meta property="twitter:creator" content="@manufosela" />

		<!-- Schema.org para el libro -->
		<script type="application/ld+json">{JSON.stringify(bookSchema)}</script>

		<!-- Schema.org para el sitio web -->
		<script type="application/ld+json">{JSON.stringify(websiteSchema)}</script>

		<!-- Analytics -->
		{analytics && <script defer src="https://stats.manulitics.com/script.js" data-website-id="1e5e5f8c-ce49-48ff-bd58-2360630deceb"></script>}
	</head>
	<body>
		<slot />
		<style is:global>
			:root {
				/* ===== Surface hierarchy — carbon dark, no pure black ===== */
				--surface: #131313;
				--surface-dim: #0E0E0E;
				--surface-container: #1C1B1B;
				--surface-container-high: #2A2A2A;
				--surface-bright: #393939;

				/* ===== Text hierarchy ===== */
				--on-surface: #F5F5F3;
				--on-surface-strong: #FFFFFF;
				--on-surface-variant: #B9CBC2;
				--on-surface-muted: #7D8884;

				/* ===== Ghost borders (felt, not seen) ===== */
				--outline-soft: rgba(255, 255, 255, 0.06);
				--outline: rgba(255, 255, 255, 0.10);
				--outline-strong: rgba(255, 255, 255, 0.15);
				--outline-variant: #3A4A44;

				/* ===== The Mint Pulse — single accent ===== */
				--primary: #00E0B3;
				--primary-bright: #00FFCC;
				--primary-dim: #00C896;
				--primary-subtle: rgba(0, 224, 179, 0.12);
				--on-primary: #0D1F1A;
				--primary-gradient: linear-gradient(135deg, #00E0B3 0%, #00FFCC 100%);

				/* ===== Muted states ===== */
				--error: #FFB4AB;
				--error-surface: rgba(255, 180, 171, 0.08);
				--success: #7DD3B8;

				/* ===== Typography ===== */
				--font-display: 'Manrope', system-ui, -apple-system, sans-serif;
				--font-body: 'Inter', system-ui, -apple-system, sans-serif;

				/* ===== Spacing — editorial ===== */
				--space-2xs: 0.25rem;
				--space-xs: 0.5rem;
				--space-sm: 1rem;
				--space-md: 1.5rem;
				--space-lg: 2.5rem;
				--space-xl: 5rem;
				--space-2xl: 8rem;

				/* ===== Layout ===== */
				--max-width: 1200px;
				--max-width-content: 720px;
				--header-height: 76px;
				--footer-height: 60px;

				/* ===== Radii ===== */
				--radius-sm: 0.375rem;
				--radius-md: 0.75rem;
				--radius-lg: 1.25rem;
				--radius-xl: 1.75rem;

				/* ===== Ambient shadows only — absorbing light, not grey smudge ===== */
				--shadow-ambient: 0 24px 48px rgba(0, 0, 0, 0.4);
				--shadow-float: 0 12px 32px rgba(0, 0, 0, 0.3);
				--shadow-glow: 0 0 40px rgba(0, 224, 179, 0.12);

				/* ===== Legacy aliases (retro-compat with existing class names) ===== */
				--color-bg: var(--surface);
				--color-gold: var(--primary);
				--color-gold-hover: var(--primary-bright);
				--font-heading: var(--font-display);
			}

			*,
			*::before,
			*::after {
				box-sizing: border-box;
			}

			html {
				font-family: var(--font-body);
				background: var(--surface);
				color: var(--on-surface);
				-webkit-font-smoothing: antialiased;
				-moz-osx-font-smoothing: grayscale;
				scroll-behavior: smooth;
			}

			body {
				margin: 0;
				min-height: 100vh;
				display: flex;
				flex-direction: column;
				line-height: 1.6;
				font-size: 1rem;
				background: var(--surface);
				color: var(--on-surface);
			}

			main {
				padding-bottom: var(--footer-height);
				flex: 1;
			}

			h1, h2, h3, h4 {
				font-family: var(--font-display);
				color: var(--on-surface-strong);
				line-height: 1.1;
				letter-spacing: -0.02em;
				font-weight: 700;
			}

			a {
				color: var(--primary);
				text-decoration: none;
				transition: color 0.2s ease-out;
			}

			a:hover {
				color: var(--primary-bright);
			}

			img {
				max-width: 100%;
				height: auto;
				display: block;
			}

			::selection {
				background: var(--primary-subtle);
				color: var(--on-surface-strong);
			}

			:focus-visible {
				outline: 2px solid var(--primary);
				outline-offset: 3px;
				border-radius: 2px;
			}
		</style>
	</body>
</html>
